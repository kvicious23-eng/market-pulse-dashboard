{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/publicmp.mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/publicmp/:path*",
      "destination": "/api/publicmp?route=:path*"
    }
  ],
  "outputDirectory": "public"
}
