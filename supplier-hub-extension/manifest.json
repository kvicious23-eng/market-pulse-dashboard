{
  "manifest_version": 3,
  "name": "Supplier Hub Connector for Market Pulse",
  "short_name": "Supplier Hub",
  "version": "0.1.4",
  "description": "Maintains a Supplier Hub connection in this Chrome profile using local Windows credentials.",
  "key": "",
  "permissions": ["alarms", "tabs", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["https://supplier.coupang.com/*", "https://xauth.coupang.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "icons": {"16":"icons/sh-16.png","32":"icons/sh-32.png","48":"icons/sh-48.png","128":"icons/sh-128.png"},
  "action": {"default_title": "Supplier Hub Connector for Market Pulse", "default_icon":{"16":"icons/sh-16.png","32":"icons/sh-32.png","48":"icons/sh-48.png","128":"icons/sh-128.png"}},
  "options_page": "options.html"
}
