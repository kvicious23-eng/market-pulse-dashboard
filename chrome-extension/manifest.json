{
  "manifest_version": 3,
  "name": "Market Pulse Coupang Scanner",
  "version": "1.9.36",
  "description": "Reads exact Coupang item prices in a normal Chrome session.",
  "icons": {
    "16": "icons/mp-16.png",
    "32": "icons/mp-32.png",
    "48": "icons/mp-48.png",
    "128": "icons/mp-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.coupang.com/*",
    "https://order.coupang.com/*",
    "https://checkout.coupang.com/*",
    "https://prod.danawa.com/*",
    "https://price.enuri.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Market Pulse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mp-16.png",
      "32": "icons/mp-32.png",
      "48": "icons/mp-48.png",
      "128": "icons/mp-128.png"
    }
  },
  "options_page": "options.html",
  "externally_connectable": {
    "ids": [
      "djmlkkflbncanonpjhkdhghjmcompjnp"
    ]
  }
}
